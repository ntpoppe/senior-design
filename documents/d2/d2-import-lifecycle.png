<mxfile host="app.diagrams.net"><diagram id="d" name="Analyzing one move (Figure 3)"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1070"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Chess Blunder-Risk Analyzer: Analyzing one move (Figure 3)" style="text;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="940" height="28" as="geometry"/></mxCell><mxCell id="goal" value="Goal: estimate how likely a player is to blunder from a given position, and show the riskiest moves and why." style="text;fontSize=12;fontColor=#6b6b6b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="940" height="18" as="geometry"/></mxCell><mxCell id="sub" value="Runs for every stored move after import. Red dashed paths are failures and how each is handled." style="text;fontSize=12;fontStyle=2;fontColor=#6b6b6b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="940" height="18" as="geometry"/></mxCell><mxCell id="s" value="Next stored move" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175.0" y="90.0" width="250" height="40" as="geometry"/></mxCell><mxCell id="d1" value="Player&#x27;s move?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="157.0" width="200" height="62" as="geometry"/></mxCell><mxCell id="d2" value="Only one legal move?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="237.0" width="200" height="62" as="geometry"/></mxCell><mxCell id="p1" value="Stockfish searches the position" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175.0" y="326.0" width="250" height="44" as="geometry"/></mxCell><mxCell id="d3" value="Search worked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="397.0" width="200" height="62" as="geometry"/></mxCell><mxCell id="p2" value="Build the feature row" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175.0" y="486.0" width="250" height="44" as="geometry"/></mxCell><mxCell id="p3" value="Model predicts a risk score" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175.0" y="556.0" width="250" height="44" as="geometry"/></mxCell><mxCell id="d5" value="Score valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="627.0" width="200" height="62" as="geometry"/></mxCell><mxCell id="p4" value="Pick risk factors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175.0" y="716.0" width="250" height="44" as="geometry"/></mxCell><mxCell id="p5" value="Save score and factors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175.0" y="786.0" width="250" height="44" as="geometry"/></mxCell><mxCell id="d6" value="Save worked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="857.0" width="200" height="62" as="geometry"/></mxCell><mxCell id="end" value="Move complete" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1f4e5f;strokeColor=#1f4e5f;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200.0" y="946.0" width="200" height="44" as="geometry"/></mxCell><mxCell id="skip" value="Skip: not scored" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510.0" y="166.0" width="220" height="44" as="geometry"/></mxCell><mxCell id="forced" value="Mark forced: no score" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f7fafb;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510.0" y="246.0" width="220" height="44" as="geometry"/></mxCell><mxCell id="retry" value="Restart engine, try once more" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ef;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510.0" y="406.0" width="220" height="44" as="geometry"/></mxCell><mxCell id="d4" value="Worked now?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e5f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530.0" y="489.0" width="180" height="58" as="geometry"/></mxCell><mxCell id="unav" value="Mark unavailable and log it" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ef;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770.0" y="490.0" width="200" height="56" as="geometry"/></mxCell><mxCell id="empty" value="Store an empty score and log it" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ef;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510.0" y="630.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="fallback" value="No model reasons: use rule-based factors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1ef;strokeColor=#c0392b;fontColor=#c0392b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510.0" y="710.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="partial" value="Retry once, then leave the game marked partial" style="rounded=1;arcSize=10;white